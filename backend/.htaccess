# Deny access to SQLite database files, INI configs, and environment variables
<FilesMatch "\.(sqlite|db|ini)$|^\.env">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Allow CORS if needed at Apache level, though PHP handles it in db.php
# Header set Access-Control-Allow-Origin "*"

# Ensure Authorization header is passed to PHP (required for JWT on FastCGI/shared hosting)
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# If the file actually exists (like old product images), serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route new uploads to public/uploads
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

# Route all other requests to public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php [QSA,L]
